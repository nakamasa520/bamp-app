{
  "name": "bamp-task-test",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "bamp-task", "database_id": "local-test", "migrations_dir": "migrations" }],
  "vars": { "AI_MOCK": "1" }
}
